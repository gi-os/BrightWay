<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ZXing's embedded scanner for API-key entry. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Navigation with the screen off. NavService is a foreground service with the
        `location` type, alive strictly between "route chosen" and "arrived / END / 4 h
        cap" — see nav/NavService.kt for why those boundaries are hard ones. No
        ACCESS_BACKGROUND_LOCATION: the service starts in the foreground and the FGS type
        keeps while-in-use access for exactly as long as the trip runs.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The FGS notification on API 33+. Denied, navigation still runs — the shade line
         "tap to return" is the only thing missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Colour during navigation. LightOS's black-and-white is a SurfaceFlinger colour
        matrix pinned by accessibility_display_daltonizer_enabled; flipping it needs this
        signature|privileged|development permission, granted once over adb:
          adb shell pm grant com.gios.brightway android.permission.WRITE_SECURE_SETTINGS
        Ungranted, the app stays greyscale and everything else works.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Directions"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrightWay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@mipmap/ic_launcher"
            android:label="Directions"
            android:theme="@style/Theme.BrightWay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Somewhere to go, handed over by another app. BrightNotebook is the one that asked:
              a calendar entry with an address on it should be one tap from directions, the way it
              is on every other phone, and on this one there was nothing to tap *to*.

              Two ways in, because a location arrives in two shapes and only one of them is ours:

                brightway://go?q=<text>   — our own, and the one a sibling app uses.
                geo:0,0?q=<text>          — the standard one, so anything on the phone that knows
                geo:<lat>,<lon>             how to ask for a map can ask this app. Coordinates are
                                            accepted and searched as text, which the Places API
                                            handles and which keeps one path through the app.

              Both land on the search results rather than starting a route. A calendar's location
              is a string somebody typed — "Regal Union Square", "moms" — and routing straight off
              it would mean walking a stranger somewhere on the strength of a guess. Showing what
              it matched, with the address, is one extra press and no wrong turns.
            -->
            <intent-filter android:label="Directions">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brightway" android:host="go" />
            </intent-filter>

            <intent-filter android:label="Directions">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
        <!--
          Where you went, for BrightNotebook's day. This app was the only thing on the phone that
          knew you walked somewhere and the only thing that forgot it immediately — see
          data/Trips.kt. Exported with no permission, like the collection's other bridges, and
          read-only.
        -->
        <provider
            android:name=".share.TripsProvider"
            android:authorities="com.gios.brightway.trips"
            android:exported="true" />

        <!--
          Where you're going right now, for BrightControl's lock face. One row while
          navigating, empty otherwise; same terms as the trips bridge — exported, no
          permission, read-only. See share/NavProvider.kt for the pinned column contract.
        -->
        <provider
            android:name=".share.NavProvider"
            android:authorities="com.gios.brightway.nav"
            android:exported="true" />

        <!--
          The trip itself, once the screen is allowed to turn off. Route-scoped by design:
          started when a route is chosen, gone on arrival, END, or the four-hour cap.
        -->
        <service
            android:name=".nav.NavService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
